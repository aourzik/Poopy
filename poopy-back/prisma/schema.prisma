datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 👤 TABLE UTILISATEUR
model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  passwordHash String?
  diagnosis    String?       // RCH, Crohn, MICI indéterminée...
  avatarUrl    String?       // Base64 de la photo de profil
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  stools       Stool[]
  medications  Medication[]
  appointments Appointment[]
  labs         MedicalLab[]
  weights      Weight[]
}

// 💩 1. JOURNAL DES SELLES
model Stool {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  count     Int      @default(1)
  bristol   Int
  blood     Boolean  @default(false)
  urgency   Boolean  @default(false)

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 💊 2. SUIVI DES MÉDICAMENTS / TRAITEMENTS
model Medication {
  id           String   @id @default(uuid())
  name         String
  dose         String
  frequency    String
  totalToday   Int?
  isInjection  Boolean  @default(false)
  color        String   @default("amber")

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs         MedicationLog[]

  @@index([userId])
}

model MedicationLog {
  id           String     @id @default(uuid())
  takenAt      DateTime   @default(now())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
}

// 🏥 3. RENDEZ-VOUS MÉDICAUX
model Appointment {
  id          String   @id @default(uuid())
  date        DateTime
  doctor      String
  location    String
  type        String
  notes       String?
  preparation String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 🧪 4. ANALYSES CLINIQUES & BIOLOGIQUES
model MedicalLab {
  id             String   @id @default(uuid())
  date           DateTime @default(now())
  type           String   @default("blood")  // "blood" ou "calprotectin"
  calprotectin   Float?
  crp            Float?
  b12            Float?   // Vitamine B12 (pg/mL)
  b9             Float?   // Vitamine B9 / Folate (µg/L)
  ferritin       Float?   // Ferritine (ng/mL)
  iron           Float?   // Fer sérique (µmol/L)
  notes          String?

  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 📈 5. SUIVI DU POIDS
model Weight {
  id        String   @id @default(uuid())
  value     Float
  date      DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
